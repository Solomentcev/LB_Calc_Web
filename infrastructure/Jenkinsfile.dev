pipeline {
    agent any

    parameters {
        string(name: 'SOURCE_BRANCH', defaultValue: '',
            description: 'Ветка feature/*, refactor/* или bugfix/* для сборки DEV')
    }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        MAVEN_SETTINGS = '/var/jenkins_home/.m2/settings.xml'
        DEV_COMPOSE = 'environments/dev/docker-compose.yml'
        DEV_ENV_FILE = '/var/jenkins_env/dev.env'
    }

    stages {
        stage('Validate selected branch') {
            steps {
                script {
                    def sourceBranch = params.SOURCE_BRANCH?.trim()
                    if (!sourceBranch || !(sourceBranch ==~ /^(feature|refactor|bugfix)\/[A-Za-z0-9._\/-]+$/)
                            || sourceBranch.contains('..') || sourceBranch.contains('//')) {
                        error('Укажите существующую ветку формата feature/*, refactor/* или bugfix/*.')
                    }
                    env.SOURCE_BRANCH = sourceBranch
                    env.BRANCH_SLUG = sourceBranch.toLowerCase().replaceAll(/[^a-z0-9]+/, '-')
                            .replaceAll(/^-+|-+$/, '')
                }
            }
        }

        stage('Checkout selected branch') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${params.SOURCE_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: 'git@github.com:Solomentcev/LB_Calc_Web.git',
                        credentialsId: 'github-ssh'
                    ]]
                ])
                sh 'git fetch --tags https://github.com/Solomentcev/LB_Calc_Web.git'
            }
        }

        stage('Resolve snapshot version') {
            steps {
                script {
                    def latestTag = sh(
                        script: "git tag --list 'v[0-9]*' --sort=-v:refname | head -n 1",
                        returnStdout: true
                    ).trim()

                    def baseVersion = latestTag
                        ? latestTag.replaceFirst(/^v/, '')
                        : sh(
                            script: 'mvn -s "$MAVEN_SETTINGS" help:evaluate -Dexpression=revision -q -DforceStdout',
                            returnStdout: true
                        ).trim().replaceFirst(/-SNAPSHOT$/, '')

                    if (!(baseVersion ==~ /\d+\.\d+\.\d+/)) {
                        error("Некорректная базовая SemVer-версия: ${baseVersion}")
                    }

                    env.APP_VERSION = "${baseVersion}-SNAPSHOT"
                    def tagPrefix = "${env.APP_VERSION}-"
                    def tagSuffix = "-build-${env.BUILD_NUMBER}"
                    def maxBranchSlugLength = 128 - tagPrefix.length() - tagSuffix.length()

                    if (maxBranchSlugLength < 1) {
                        error('Не удалось сформировать допустимый Docker tag.')
                    }

                    env.BRANCH_SLUG = env.BRANCH_SLUG.take(maxBranchSlugLength)
                    env.IMAGE_TAG = "${tagPrefix}${env.BRANCH_SLUG}${tagSuffix}"

                    echo "DEV branch: ${env.SOURCE_BRANCH}"
                    echo "Application version: ${env.APP_VERSION}"
                    echo "Docker image tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Build and test') {
            steps {
                sh 'mvn -s "$MAVEN_SETTINGS" clean verify -Drevision="$APP_VERSION"'
            }
        }

        stage('Build Docker images') {
            steps {
                sh '''
                    set -eu
                    test -f "$DEV_ENV_FILE"

                    APP_VERSION="$APP_VERSION" IMAGE_TAG="$IMAGE_TAG" \
                    docker compose --env-file "$DEV_ENV_FILE" \
                        -f "$DEV_COMPOSE" config -q

                    APP_VERSION="$APP_VERSION" IMAGE_TAG="$IMAGE_TAG" \
                    docker compose --env-file "$DEV_ENV_FILE" \
                        -f "$DEV_COMPOSE" build lb-calc-web notification-service
                '''
            }
        }

        stage('Check DEV infrastructure') {
            steps {
                sh '''
                    set -eu

                    check_healthy_container() {
                        container_name="$1"
                        state=$(docker inspect --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}no-healthcheck{{end}}' "$container_name" 2>/dev/null || true)

                        if [ "$state" != "running healthy" ]; then
                            echo "Контейнер инфраструктуры $container_name должен быть running/healthy; текущее состояние: ${state:-не найден}"
                            exit 1
                        fi
                    }

                    check_healthy_container lb-calc-dev-mysql
                    check_healthy_container lb-calc-dev-kafka
                '''
            }
        }

        stage('Deploy DEV applications') {
            steps {
                sh '''
                    APP_VERSION="$APP_VERSION" IMAGE_TAG="$IMAGE_TAG" \
                    docker compose --env-file "$DEV_ENV_FILE" \
                        -f "$DEV_COMPOSE" \
                        up -d --no-build --force-recreate --no-deps \
                        lb-calc-web notification-service
                '''
            }
        }

        stage('Verify DEV') {
            steps {
                sh '''
                    set -eu
                    WEB_PORT=$(APP_VERSION="$APP_VERSION" IMAGE_TAG="$IMAGE_TAG" docker compose \
                        --env-file "$DEV_ENV_FILE" \
                        -f "$DEV_COMPOSE" port lb-calc-web 8081 \
                        | tail -n 1 | awk -F: '{print $NF}')

                    if [ -z "$WEB_PORT" ]; then
                        echo "Не удалось определить опубликованный порт DEV web."
                        exit 1
                    fi

                    for attempt in $(seq 1 30); do
                        if curl --fail --silent "http://127.0.0.1:$WEB_PORT/login" >/dev/null; then
                            NOTIFICATION_STATE=$(docker inspect \
                                --format='{{.State.Running}}' lb-calc-dev-notification 2>/dev/null || true)

                            if [ "$NOTIFICATION_STATE" = "true" ]; then
                                echo "DEV web и notification-service запущены."
                                exit 0
                            fi
                        fi
                        sleep 2
                    done

                    APP_VERSION="$APP_VERSION" IMAGE_TAG="$IMAGE_TAG" docker compose \
                        --env-file "$DEV_ENV_FILE" \
                        -f "$DEV_COMPOSE" \
                        logs --tail=100 lb-calc-web notification-service
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo "DEV успешно развёрнут: ${env.SOURCE_BRANCH}, ${env.APP_VERSION}, ${env.IMAGE_TAG}"
        }
        failure {
            echo 'Сборка или развёртывание DEV завершились ошибкой.'
        }
    }
}