pipeline {
    agent any
    options { disableConcurrentBuilds() }

    parameters {
        string(name: 'SOURCE_BRANCH', defaultValue: 'refactor-main',
               description: 'Ветка для DEV: feature/*, refactor/*, bugfix/*')
    }

    environment {
        MAVEN_SETTINGS = '/var/jenkins_home/.m2/settings.xml'
        DEV_COMPOSE = 'environments/dev/docker-compose.yml'
        DEV_ENV_FILE = '/var/jenkins_env/dev/.env'
    }

    stages {
        stage('Validate branch') {
            steps {
                script {
                    def sourceBranch = params.SOURCE_BRANCH?.trim()
                    def allowedBranch = sourceBranch == 'refactor-main' ||
                            sourceBranch ==~ /^(feature|refactor|bugfix)\/[A-Za-z0-9][A-Za-z0-9._/-]*$/
                    if (!allowedBranch) {
                        error('Допустимы refactor-main и ветки feature/*, refactor/*, bugfix/*')
                    }
                    env.SOURCE_BRANCH = sourceBranch
                }
            }
        }

        stage('Checkout source branch') {
            steps {
                deleteDir()
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${env.SOURCE_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: 'git@github.com:Solomentcev/LB_Calc_Web.git',
                        credentialsId: 'github-ssh'
                    ]],
                    extensions: [[
                        $class: 'CloneOption',
                        shallow: false,
                        noTags: false
                    ]]
                ])
                script {
                    env.DEPLOY_COMMIT = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()
                    sh 'git fetch --tags https://github.com/Solomentcev/LB_Calc_Web.git'
                }
            }
        }

        stage('Resolve application version') {
            steps {
                script {
                    def latestTag = sh(
                        script: "git tag --list 'v[0-9]*' --sort=-v:refname | head -n 1",
                        returnStdout: true
                    ).trim()

                    def baseVersion
                    if (latestTag) {
                        baseVersion = latestTag.replaceFirst(/^v/, '')
                    } else {
                        baseVersion = sh(
                            script: 'mvn -s "$MAVEN_SETTINGS" help:evaluate -Dexpression=revision -q -DforceStdout',
                            returnStdout: true
                        ).trim().replaceFirst(/-SNAPSHOT$/, '')
                    }

                    if (!(baseVersion ==~ /\d+\\.\d+\\.\d+/)) {
                        error("Не удалось определить базовую SemVer-версию: ${baseVersion}")
                    }

                    env.APP_VERSION = "${baseVersion}-SNAPSHOT"
                    def branchSlug = env.SOURCE_BRANCH.toLowerCase()
                            .replaceAll(/[^a-z0-9_.-]+/, '-')
                            .replaceAll(/^-+|-+$/, '')
                    def tagPrefix = "${env.APP_VERSION}-"
                    def tagSuffix = "-build-${env.BUILD_NUMBER}"
                    def maxBranchSlugLength = 128 - tagPrefix.length() - tagSuffix.length()

                    if (maxBranchSlugLength < 1) {
                        error('Не удалось сформировать допустимый Docker tag.')
                    }

                    branchSlug = branchSlug.take(maxBranchSlugLength)
                    env.IMAGE_TAG = "${tagPrefix}${branchSlug}${tagSuffix}"
                }
            }
        }

        stage('Build') {
            steps {
                sh 'mvn -s "$MAVEN_SETTINGS" clean package -DskipTests -Drevision="$APP_VERSION"'
            }
        }

        stage('Check DEV infrastructure') {
            steps {
                sh '''
                    set -eu

                    check_healthy_container() {
                        container_name="$1"
                        state=$(docker inspect --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}no-healthcheck{{end}}' "$container_name" 2>/dev/null || true)

                        if [ "$state" != "running healthy" ]; then
                            echo "Контейнер инфраструктуры $container_name должен быть running/healthy; текущее состояние: ${state:-не найден}"
                            exit 1
                        fi

                        echo "Инфраструктура доступна: $container_name ($state)"
                    }

                    check_healthy_container lb-calc-dev-mysql
                    check_healthy_container lb-calc-dev-kafka
                '''
            }
        }

        stage('Deploy DEV applications') {
            steps {
                sh '''
                    set -eu

                    APP_VERSION="$APP_VERSION" IMAGE_TAG="$IMAGE_TAG" docker compose \
                        --env-file "$DEV_ENV_FILE" \
                        -f "$DEV_COMPOSE" \
                        up -d --build --force-recreate --no-deps \
                        lb-calc-web notification-service

                    for container_name in lb-calc-dev-web lb-calc-dev-notification; do
                        state=$(docker inspect --format '{{.State.Status}}' "$container_name" 2>/dev/null || true)
                        if [ "$state" != "running" ]; then
                            echo "Контейнер приложения $container_name не запущен; состояние: ${state:-не найден}"
                            exit 1
                        fi
                        echo "Приложение запущено: $container_name"
                    done
                '''
            }
        }
    }

    post {
        success {
            echo "Развёртывание DEV завершено. Ветка: ${env.SOURCE_BRANCH}, commit: ${env.DEPLOY_COMMIT}, версия: ${env.APP_VERSION}, image tag: ${env.IMAGE_TAG}"
        }
        failure {
            echo 'Развёртывание DEV завершилось ошибкой.'
        }
    }
}
