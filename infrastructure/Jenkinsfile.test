pipeline {
    agent any
    options { disableConcurrentBuilds() }

    environment {
        MAVEN_SETTINGS = '/var/jenkins_home/.m2/settings.xml'
    }

    stages {
        stage('Checkout master') {
            steps {
                script {
                    def scmVars = checkout scm
                    env.DEPLOY_COMMIT = scmVars.GIT_COMMIT
                }
                sh 'git fetch --tags https://github.com/Solomentcev/LB_Calc_Web.git'
            }
        }

        stage('Resolve release version') {
            steps {
                script {
                    def pullRequestsJson = sh(
                        script: """curl --fail --silent --show-error \
                            -H 'Accept: application/vnd.github+json' \
                            -H 'X-GitHub-Api-Version: 2022-11-28' \
                            'https://api.github.com/repos/Solomentcev/LB_Calc_Web/commits/${env.DEPLOY_COMMIT}/pulls'""",
                        returnStdout: true
                    ).trim()

                    def pullRequests = new groovy.json.JsonSlurperClassic().parseText(pullRequestsJson)
                    def mergedPullRequest = pullRequests.find {
                        it.base?.ref == 'master' &&
                                it.merged_at &&
                                it.merge_commit_sha == env.DEPLOY_COMMIT
                    }

                    if (mergedPullRequest == null) {
                        error("Для commit ${DEPLOY_COMMIT} не найден merged PR в master. Прямые изменения master запрещены.")
                    }

                    def versionLabels = mergedPullRequest.labels
                            .collect { it.name }
                            .findAll { it in ['version:patch', 'version:minor', 'version:major'] }

                    if (versionLabels.size() != 1) {
                        error("PR #${mergedPullRequest.number} должен содержать ровно одну метку version:patch, version:minor или version:major.")
                    }
                    env.VERSION_LABEL = versionLabels[0]

                    def existingTag = sh(
                        script: "git tag --points-at '${DEPLOY_COMMIT}' --list 'v[0-9]*' | head -n 1",
                        returnStdout: true
                    ).trim()

                    if (existingTag) {
                        env.RELEASE_TAG = existingTag
                        env.APP_VERSION = existingTag.replaceFirst(/^v/, '')
                        echo "Для commit уже существует тег ${existingTag}; используем его повторно."
                    } else {
                        def latestTag = sh(
                            script: "git tag --list 'v[0-9]*' --sort=-v:refname | head -n 1",
                            returnStdout: true
                        ).trim()

                        def baseVersion
                        if (latestTag) {
                            baseVersion = latestTag.replaceFirst(/^v/, '')
                        } else {
                            baseVersion = sh(
                                script: 'mvn -s "$MAVEN_SETTINGS" help:evaluate -Dexpression=revision -q -DforceStdout',
                                returnStdout: true
                            ).trim().replaceFirst(/-SNAPSHOT$/, '')
                        }

                        if (!(baseVersion ==~ /\d+\.\d+\.\d+/)) {
                            error("Не удалось определить базовую SemVer-версию: ${baseVersion}")
                        }

                        def parts = baseVersion.tokenize('.').collect { it.toInteger() }
                        def major = parts[0]
                        def minor = parts[1]
                        def patch = parts[2]

                        switch (env.VERSION_LABEL) {
                            case 'version:major':
                                major++
                                minor = 0
                                patch = 0
                                break
                            case 'version:minor':
                                minor++
                                patch = 0
                                break
                            case 'version:patch':
                                patch++
                                break
                            default:
                                error("Неизвестная метка версии: ${env.VERSION_LABEL}")
                        }

                        env.APP_VERSION = "${major}.${minor}.${patch}"
                        env.RELEASE_TAG = "v${env.APP_VERSION}"
                    }

                    env.IMAGE_TAG = "${APP_VERSION}-build-${env.BUILD_NUMBER}"
                    echo "PR #${mergedPullRequest.number}; метка: ${VERSION_LABEL}; версия: ${APP_VERSION}; commit: ${DEPLOY_COMMIT}"
                }
            }
        }

        stage('Build release') {
            steps {
                sh 'mvn -s "$MAVEN_SETTINGS" clean package -DskipTests -Drevision="$APP_VERSION"'
            }
        }

        stage('Create Git tag') {
            steps {
                script {
                    def tagExists = sh(
                        script: "git show-ref --verify --quiet 'refs/tags/${env.RELEASE_TAG}'",
                        returnStatus: true
                    ) == 0

                    if (!tagExists) {
                        sh 'git tag -a "$RELEASE_TAG" "$DEPLOY_COMMIT" -m "Релиз $RELEASE_TAG"'
                        withCredentials([
                            sshUserPrivateKey(
                                credentialsId: 'github-ssh',
                                keyFileVariable: 'GITHUB_SSH_KEY',
                                usernameVariable: 'GITHUB_SSH_USER'
                            )
                        ]) {
                            sh '''
                                export GIT_SSH_COMMAND="ssh -i $GITHUB_SSH_KEY -o IdentitiesOnly=yes"
                                git push origin "refs/tags/$RELEASE_TAG"
                            '''
                        }
                    } else {
                        def taggedCommit = sh(
                            script: "git rev-list -n 1 '${RELEASE_TAG}'",
                            returnStdout: true
                        ).trim()
                        if (taggedCommit != env.DEPLOY_COMMIT) {
                            error("Тег ${RELEASE_TAG} уже существует и указывает на другой commit.")
                        }
                    }
                }
            }
        }

        stage('Deploy TEST') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'test-host-ssh',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        : "${TEST_HOST:?В Jenkins необходимо задать TEST_HOST}"
                        : "${TEST_PROJECT_DIR:?В Jenkins необходимо задать TEST_PROJECT_DIR}"
                        : "${APP_VERSION:?Не определена версия приложения}"
                        : "${IMAGE_TAG:?Не определён Docker tag}"
                        : "${DEPLOY_COMMIT:?Не определён commit для развёртывания}"

                        ssh -i "$SSH_KEY" -o BatchMode=yes \
                            "$SSH_USER@$TEST_HOST" \
                            "cd '$TEST_PROJECT_DIR' && \
                             git fetch origin master --tags && \
                             git checkout --detach '$DEPLOY_COMMIT' && \
                             mkdir -p lb-calc-web/target notification-service/target"

                        scp -i "$SSH_KEY" -o BatchMode=yes \
                            "lb-calc-web/target/lb-calc-web-$APP_VERSION.jar" \
                            "$SSH_USER@$TEST_HOST:$TEST_PROJECT_DIR/lb-calc-web/target/"

                        scp -i "$SSH_KEY" -o BatchMode=yes \
                            "notification-service/target/notification-service-$APP_VERSION.jar" \
                            "$SSH_USER@$TEST_HOST:$TEST_PROJECT_DIR/notification-service/target/"

                        ssh -i "$SSH_KEY" -o BatchMode=yes \
                            "$SSH_USER@$TEST_HOST" \
                            "cd '$TEST_PROJECT_DIR' && \
                             APP_VERSION='$APP_VERSION' IMAGE_TAG='$IMAGE_TAG' docker compose \
                               --env-file environments/test/.env \
                               -f environments/test/docker-compose.yml \
                               up -d --build --force-recreate"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Развёртывание TEST завершено. Commit: ${env.DEPLOY_COMMIT}, версия: ${env.APP_VERSION}, тег: ${env.RELEASE_TAG}, image tag: ${env.IMAGE_TAG}"
        }
        failure {
            echo 'Развёртывание TEST завершилось ошибкой.'
        }
    }
}
