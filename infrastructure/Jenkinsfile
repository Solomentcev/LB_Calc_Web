pipeline {
    agent any

    parameters {
        choice(name: 'TARGET', choices: ['DEV', 'TEST'], description: 'Стенд развёртывания')
    }

    environment {
        MAVEN_SETTINGS = '/var/jenkins_home/.m2/settings.xml'
        DEV_COMPOSE = 'environments/dev/docker-compose.yml'
        DEV_ENV_FILE = '/var/jenkins_env/dev/.env'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    def targetBranch = params.TARGET == 'DEV' ? 'refactor-main' : 'master'
                    git(
                        branch: targetBranch,
                        credentialsId: 'github-ssh',
                        url: 'git@github.com:Solomentcev/LB_Calc_Web.git'
                    )
                }
            }
        }

        stage('Get version') {
            steps {
                script {
                    env.APP_VERSION = sh(
                        script: "mvn -s ${MAVEN_SETTINGS} help:evaluate -Dexpression=revision -q -DforceStdout",
                        returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Build') {
            steps {
                sh "mvn -s ${MAVEN_SETTINGS} clean package -DskipTests -Drevision=${APP_VERSION}"
            }
        }

        stage('Deploy DEV') {
            when { expression { params.TARGET == 'DEV' } }
            steps {
                sh """
                    APP_VERSION=${APP_VERSION} docker compose \\
                        --env-file ${DEV_ENV_FILE} \\
                        -f ${DEV_COMPOSE} \\
                        up -d --build --force-recreate
                """
            }
        }

        stage('Deploy TEST') {
            when { expression { params.TARGET == 'TEST' } }
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'test-host-ssh',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        : "${TEST_HOST:?В Jenkins необходимо задать TEST_HOST}"
                        : "${TEST_PROJECT_DIR:?В Jenkins необходимо задать TEST_PROJECT_DIR}"
                        : "${APP_VERSION:?Не определена версия приложения}"
                        : "${GIT_COMMIT:?Не определён commit для развёртывания}"

                        ssh -i "$SSH_KEY" -o BatchMode=yes \
                            "$SSH_USER@$TEST_HOST" \
                            "cd '$TEST_PROJECT_DIR' && \
                             git fetch origin master && \
                             git checkout --detach '$GIT_COMMIT' && \
                             mkdir -p lb-calc-web/target notification-service/target"

                        scp -i "$SSH_KEY" -o BatchMode=yes \
                            "lb-calc-web/target/lb-calc-web-$APP_VERSION.jar" \
                            "$SSH_USER@$TEST_HOST:$TEST_PROJECT_DIR/lb-calc-web/target/"

                        scp -i "$SSH_KEY" -o BatchMode=yes \
                            "notification-service/target/notification-service-$APP_VERSION.jar" \
                            "$SSH_USER@$TEST_HOST:$TEST_PROJECT_DIR/notification-service/target/"

                        ssh -i "$SSH_KEY" -o BatchMode=yes \
                            "$SSH_USER@$TEST_HOST" \
                            "cd '$TEST_PROJECT_DIR' && \
                             APP_VERSION='$APP_VERSION' docker compose \
                               --env-file environments/test/.env \
                               -f environments/test/docker-compose.yml \
                               up -d --build --force-recreate"
                    '''
                }
            }
        }
    }

    post {
        success { echo "Развёртывание ${params.TARGET} завершено. Версия: ${APP_VERSION}" }
        failure { echo "Развёртывание ${params.TARGET} завершилось ошибкой." }
    }
}
