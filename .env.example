# DEV: параметры для запуска сервисов внутри Docker Compose
APP_VERSION=0.1.0-SNAPSHOT

MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=lb_calc_web_dev
MYSQL_PORT=3307

# Адреса внутри сети Docker Compose
DB_URL=jdbc:mysql://mysql:3306/lb_calc_web_dev?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Kafka
KAFKA_EXTERNAL_PORT=29092
KAFKA_TOPIC_USER_EVENTS=user-events-topic

# Приложения
WEB_PORT=8081
NOTIFICATION_PORT=8082
NOTIFICATION_PORT=8082

# JWT — замените на собственные секреты
JWT_SECRET_ACCESS=CHANGE_ME
JWT_SECRET_REFRESH=CHANGE_ME
JWT_EXPIRATION_ACCESS=36000000
JWT_EXPIRATION_REFRESH=252000000
