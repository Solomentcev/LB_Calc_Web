# LAN IP ноутбука с Docker (закрепить через DHCP reservation).
# Один и тот же адрес используется приложениями из IntelliJ IDEA и Docker.
DOCKER_HOST_ADDRESS=192.168.1.101

APP_VERSION=0.1.0-SNAPSHOT

# Опубликованные порты Docker-хоста
WEB_PORT=8081
NOTIFICATION_PORT=8082
MYSQL_PORT=3307
KAFKA_EXTERNAL_PORT=29092

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-root-password
MYSQL_DATABASE=lb_calc_web_test
DB_USERNAME=lb_calc_app
DB_PASSWORD=replace-with-application-password

# JWT: задать отдельные случайные значения для каждого стенда.
# Например: openssl rand -base64 32
JWT_SECRET_ACCESS=replace-with-access-secret
JWT_SECRET_REFRESH=replace-with-refresh-secret
JWT_EXPIRATION_ACCESS=36000000
JWT_EXPIRATION_REFRESH=252000000

# Kafka
KAFKA_TOPIC_USER_EVENTS=user-events-topic

# Логирование основного приложения
LOGGING_LEVEL_COM_LB_CALC_WEB=INFO
